{
  "name": "wizard-redteam",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.3" },
  "scripts": {
    "attack": "node redteam.mjs",
    "escalate": "node redteam.mjs --tactics decoy-substitution,precedent-pressure,compound-stack,dilution-overload,delimiter-spoof,consensus-split --sessions all --rounds 10 --concurrency 4 --window 6",
    "tactics": "node redteam.mjs --list-tactics",
    "test": "node --test selftest.mjs",
    "lint:contracts": "genvm-lint check wizard_of_coin.py && genvm-lint check wizard_attacker.py",
    "test:contracts": "pytest -q tests"
  },
  "dependencies": {
    "genlayer-js": "^2.0.0-rc.1"
  }
}
